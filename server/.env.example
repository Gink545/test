PORT=3000
NODE_ENV=production
JWT_SECRET=please_change_to_random_long_secret
ENABLE_DEBUG_PAID_API=false

STORAGE=mysql
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=wechat
MYSQL_PASSWORD=wechat123
MYSQL_DATABASE=wechat_order

PAY_MODE=wechat_v3
WX_APPID=wx_your_appid
WX_APP_SECRET=your_app_secret
WX_MCHID=your_mchid
WX_SERIAL_NO=your_serial_no
WX_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WX_NOTIFY_URL=https://your.domain/api/pay/notify
WX_API_V3_KEY=32bytes_api_v3_key_here_12345678
WX_PLATFORM_CERT_PATH=/app/certs/wechatpay_platform.pem
