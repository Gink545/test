<view>
  <view class="card">
    <view>会员余额</view>
    <view class="price" style="font-size:44rpx;margin-top:12rpx;">¥{{balance}}</view>
  </view>

  <view class="card">
    <view>充值金额</view>
    <input type="number" value="{{amount}}" bindinput="inputAmount" style="border:1px solid #ddd;padding:12rpx;margin-top:12rpx;"/>
    <button class="btn-primary" style="margin-top:16rpx;" bindtap="recharge">微信支付充值</button>
  </view>
</view>
